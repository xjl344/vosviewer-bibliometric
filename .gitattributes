# 统一换行符：仓库内一律用 LF，避免跨平台 diff 噪声
* text=auto eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.xlsx binary
*.jar binary

# Windows 批处理保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 文本文件强制 LF
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.json text eol=lf

# 语言统计：把文档排除在「代码」之外
docs/* linguist-documentation
*.md linguist-documentation
examples/* linguist-documentation
presets/* linguist-data
